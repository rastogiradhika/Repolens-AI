# ==========================================
# REPOLENS ENVIRONMENT VARIABLES
# ==========================================

# 1. CORE SERVER CONFIG
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# 2. REPOSITORY INTELLIGENCE ENGINE (RIE)
# GitHub Personal Access Token (public_repo scope is sufficient)
GITHUB_TOKEN=

# Redis / Upstash connection URL
REDIS_URL=

# 3. DATABASE (POSTGRESQL / PRISMA)
# Required for Auth (Login/Register)
DATABASE_URL=

# 4. AUTHENTICATION (JWT & SESSION)
# Required for securing API routes and user sessions
JWT_SECRET=
SESSION_SECRET=
BCRYPT_ROUNDS=12

# 5. AI REPO GUIDE (GEMINI)
# Required for AI developer guide and chat features
GEMINI_API_KEY=
